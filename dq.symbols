// dq - "Dvorak-QWERTY Cmd" for X11 / Wayland
//
// Types like plain US Dvorak.  While Control, Alt or Super is held, every
// letter/punctuation key reverts to its QWERTY position, so Ctrl+C, Ctrl+V,
// Ctrl+Z, Alt+F, Super+L etc. stay under the fingers they live on in QWERTY.
//
// Requires the "DVORAK_QWERTY" key type from xkb/types/dq.
//
// Shift deliberately does NOT switch to QWERTY -- it just capitalises,
// otherwise you could never type a capital letter.

default partial alphanumeric_keys
xkb_symbols "basic" {

    include "us(dvorak)"

    name[Group1] = "English (Dvorak, QWERTY shortcuts)";

    // Everything below this line gets the 4-level Dvorak/QWERTY type.
    key.type[Group1] = "DVORAK_QWERTY";

    //             Dvorak         Dvorak+Shift   QWERTY         QWERTY+Shift
    key <AE11> {[ bracketleft,  braceleft,     minus,         underscore    ]};
    key <AE12> {[ bracketright, braceright,    equal,         plus          ]};

    key <AD01> {[ apostrophe,   quotedbl,      q,             Q             ]};
    key <AD02> {[ comma,        less,          w,             W             ]};
    key <AD03> {[ period,       greater,       e,             E             ]};
    key <AD04> {[ p,            P,             r,             R             ]};
    key <AD05> {[ y,            Y,             t,             T             ]};
    key <AD06> {[ f,            F,             y,             Y             ]};
    key <AD07> {[ g,            G,             u,             U             ]};
    key <AD08> {[ c,            C,             i,             I             ]};
    key <AD09> {[ r,            R,             o,             O             ]};
    key <AD10> {[ l,            L,             p,             P             ]};
    key <AD11> {[ slash,        question,      bracketleft,   braceleft     ]};
    key <AD12> {[ equal,        plus,          bracketright,  braceright    ]};

    key <AC01> {[ a,            A,             a,             A             ]};
    key <AC02> {[ o,            O,             s,             S             ]};
    key <AC03> {[ e,            E,             d,             D             ]};
    key <AC04> {[ u,            U,             f,             F             ]};
    key <AC05> {[ i,            I,             g,             G             ]};
    key <AC06> {[ d,            D,             h,             H             ]};
    key <AC07> {[ h,            H,             j,             J             ]};
    key <AC08> {[ t,            T,             k,             K             ]};
    key <AC09> {[ n,            N,             l,             L             ]};
    key <AC10> {[ s,            S,             semicolon,     colon         ]};
    key <AC11> {[ minus,        underscore,    apostrophe,    quotedbl      ]};

    key <AB01> {[ semicolon,    colon,         z,             Z             ]};
    key <AB02> {[ q,            Q,             x,             X             ]};
    key <AB03> {[ j,            J,             c,             C             ]};
    key <AB04> {[ k,            K,             v,             V             ]};
    key <AB05> {[ x,            X,             b,             B             ]};
    key <AB06> {[ b,            B,             n,             N             ]};
    key <AB07> {[ m,            M,             m,             M             ]};
    key <AB08> {[ w,            W,             comma,         less          ]};
    key <AB09> {[ v,            V,             period,        greater       ]};
    key <AB10> {[ z,            Z,             slash,         question      ]};
};
