# Re-adds the dq layout to the xkb registry after xkeyboard-config is
# upgraded, since the upgrade restores the stock rules/evdev.xml,
# rules/evdev.lst and types/complete.

[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Target = usr/share/X11/xkb/rules/*
Target = usr/share/X11/xkb/types/*
Target = usr/share/xkeyboard-config-2/rules/*
Target = usr/share/xkeyboard-config-2/types/*

[Action]
Description = Re-registering the dq keyboard layout...
When = PostTransaction
Exec = /usr/share/xkb-dvorak-qwerty/dq-patch.sh add
